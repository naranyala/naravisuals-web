{
  "Document": [
    {
      "Heading": {
        "level": 1,
        "children": [
          {
            "Text": "Filesystem Access"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "Handling files is a core requirement for many desktop apps. Tauri provides a safe way to interact with the user's disk."
        }
      ]
    },
    {
      "Heading": {
        "level": 2,
        "children": [
          {
            "Text": "Scoped Access"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "For security, Tauri uses \"scopes\". You can define which directories the app is allowed to access in your configuration. Common scopes include:"
        }
      ]
    },
    {
      "UnorderedList": []
    },
    {
      "Paragraph": [
        {
          "InlineCode": "$APPCONFIG"
        },
        {
          "Text": ": The application's configuration directory."
        }
      ]
    },
    {
      "UnorderedList": []
    },
    {
      "Paragraph": [
        {
          "InlineCode": "$APPDATA"
        },
        {
          "Text": ": The application's data directory."
        }
      ]
    },
    {
      "UnorderedList": []
    },
    {
      "Paragraph": [
        {
          "InlineCode": "$HOME"
        },
        {
          "Text": ": The user's home folder."
        }
      ]
    },
    {
      "Heading": {
        "level": 2,
        "children": [
          {
            "Text": "Reading and Writing Files"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "You can perform file operations using the "
        },
        {
          "InlineCode": "fs"
        },
        {
          "Text": " plugin."
        }
      ]
    },
    {
      "Paragraph": [
        {
          "Bold": [
            {
              "Text": "Example (Rust Backend):"
            }
          ]
        }
      ]
    },
    {
      "CodeBlock": {
        "language": "rust",
        "code": "use tauri_plugin_fs::FsExt;\n\n#[tauri::command]\nfn save_settings(app: tauri::AppHandle, data: String) {\n    let path = app.path().app_config_dir().unwrap().join(\"settings.json\");\n    std::fs::write(path, data).expect(\"Failed to write\");\n}"
      }
    },
    {
      "Heading": {
        "level": 2,
        "children": [
          {
            "Text": "Native File Dialogs"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "Instead of making the user type a path, use the "
        },
        {
          "InlineCode": "dialog"
        },
        {
          "Text": " plugin to show a native \"Open File\" or \"Save As\" window. This is the best practice for user experience and security."
        }
      ]
    }
  ]
}