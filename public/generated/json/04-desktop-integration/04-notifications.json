      "Heading": {
        "level": "H1",
        "children": [
          {
            "Text": "Native Notifications"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "Notifications are the primary way to communicate with the user when the application is minimized or running in the background."
        }
      ]
    },
    {
      "Heading": {
        "level": "H2",
        "children": [
          {
            "Text": "Sending Notifications"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "You can send a notification from the Rust backend using the notification plugin."
        }
      ]
    },
    {
      "CodeBlock": {
        "language": "rust",
        "code": "use tauri_plugin_notification::NotificationExt;\n\n#[tauri::command]\nfn send_alert(app: tauri::AppHandle) {\n    app.notification()\n        .builder()\n        .title(\"Update Complete\")\n        .body(\"Your files have been successfully synchronized.\")\n        .show()\n        .unwrap();\n}"
      }
    },
    {
      "Heading": {
        "level": "H2",
        "children": [
          {
            "Text": "Customizing Notifications"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "Depending on the OS, you can add:"
        }
      ]
    },
    {
