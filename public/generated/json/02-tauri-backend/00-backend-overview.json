  "Document": [
    {
      "Heading": {
        "level": "H1",
        "children": [
          {
            "Text": "The Tauri Backend Overview"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "The Tauri backend is where the \"heavy lifting\" of your application happens. Unlike the frontend, which is restricted by the browser's sandbox, the backend is a native Rust process with full access to the operating system."
        }
      ]
    },
    {
      "Heading": {
        "level": "H2",
        "children": [
          {
            "Text": "Role of the Backend"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "The backend serves several critical purposes:"
        }
      ]
    },
    {
      "UnorderedList": [
        {
          "checked": null,
          "children": [
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "OS Interop"
                    }
                  ]
                },
                {
                  "Text": ": Talking to the filesystem, network, and hardware."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Performance"
                    }
                  ]
                },
                {
                  "Text": ": Running computationally expensive tasks that would freeze the UI."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Security"
                    }
                  ]
                },
                {
                  "Text": ": Managing sensitive data and API keys that should never be exposed to the frontend."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Lifecycle"
                    }
                  ]
                },
                {
                  "Text": ": Controlling when the app starts, minimizes, or closes."
                }
              ]
            },
            {
              "Heading": {
                "level": "H2",
                "children": [
                  {
                    "Text": "The Rust Ecosystem"
                  }
                ]
              }
            },
            {
              "Paragraph": [
                {
                  "InlineCode": "crates.io"
                },
                {
                  "Text": ". Whether you need a database like "
                },
                {
                  "InlineCode": "sqlx"
                },
                {
                  "Text": ", a networking library like "
                },
                {
                  "InlineCode": "reqwest"
                },
                {
                  "Text": ", or a serialization tool like "
                },
                {
                  "InlineCode": "serde"
                },
                {
                  "Text": ", you have the full power of the Rust ecosystem at your disposal."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}