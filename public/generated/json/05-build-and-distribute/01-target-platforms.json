{
  "Document": [
    {
      "Heading": {
        "level": "H1",
        "children": [
          {
            "Text": "Target Platforms"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "Tauri allows you to target all major desktop operating systems from a single codebase."
        }
      ]
    },
    {
      "Heading": {
        "level": "H2",
        "children": [
          {
            "Text": "Windows"
          }
        ]
      }
    },
    {
      "Paragraph": [
        {
          "Text": "Tauri uses "
        },
        {
          "Bold": [
            {
              "Text": "WebView2"
            }
          ]
        },
        {
          "Text": " (based on Edge/Chromium)."
        }
      ]
    },
    {
      "UnorderedList": [
        {
          "checked": null,
          "children": [
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Installer"
                    }
                  ]
                },
                {
                  "Text": ": Generates "
                },
                {
                  "InlineCode": ".msi"
                },
                {
                  "Text": " and "
                },
                {
                  "InlineCode": ".exe"
                },
                {
                  "Text": "."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Requirements"
                    }
                  ]
                },
                {
                  "Text": ": Users must have the WebView2 runtime installed (which is pre-installed on Windows 10/11)."
                }
              ]
            },
            {
              "Heading": {
                "level": "H2",
                "children": [
                  {
                    "Text": "macOS"
                  }
                ]
              }
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "WebKit"
                    }
                  ]
                },
                {
                  "Text": " (the engine behind Safari)."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Installer"
                    }
                  ]
                },
                {
                  "Text": ": Generates "
                },
                {
                  "InlineCode": ".app"
                },
                {
                  "Text": " and "
                },
                {
                  "InlineCode": ".dmg"
                },
                {
                  "Text": "."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Requirements"
                    }
                  ]
                },
                {
                  "Text": ": Standard macOS environment. Note that for distribution, you will need an Apple Developer account to \"sign\" and \"notarize\" your app, otherwise users will see a security warning."
                }
              ]
            },
            {
              "Heading": {
                "level": "H2",
                "children": [
                  {
                    "Text": "Linux"
                  }
                ]
              }
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "WebKitGTK"
                    }
                  ]
                },
                {
                  "Text": "."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Installer"
                    }
                  ]
                },
                {
                  "Text": ": Generates "
                },
                {
                  "InlineCode": ".deb"
                },
                {
                  "Text": " and "
                },
                {
                  "InlineCode": "AppImage"
                },
                {
                  "Text": "."
                }
              ]
            },
            {
              "Paragraph": [
                {
                  "Bold": [
                    {
                      "Text": "Requirements"
                    }
                  ]
                },
                {
                  "Text": ": The user must have the necessary WebKitGTK libraries installed on their system."
                }
              ]
            },
            {
              "Heading": {
                "level": "H2",
                "children": [
                  {
                    "Text": "Cross-Compilation"
                  }
                ]
              }
            },
            {
              "Paragraph": [
                {
                  "InlineCode": ".exe"
                },
                {
                  "Text": " from a Mac) is complex in Rust. The recommended approach is to use "
                },
                {
                  "Bold": [
                    {
                      "Text": "GitHub Actions"
                    }
                  ]
                },
                {
                  "Text": " or other CI/CD pipelines to build the app on native runners for each platform."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}